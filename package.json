{
  "name": "luke-gallery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build",
    "lint": "eslint . --ignore-pattern .next",
    "books:discover": "node --experimental-strip-types scripts/books/refresh-discovery.ts",
    "books:covers": "node --experimental-strip-types scripts/books/discovery-covers.ts",
    "books:optimize-covers": "node --experimental-strip-types scripts/books/optimize-discovery-covers.ts",
    "books:test": "node --experimental-strip-types --test scripts/books/*.test.ts",
    "seo:test": "node --experimental-strip-types scripts/seo/verify.ts",
    "admin:test": "node --experimental-strip-types --test admin-lib/admin/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@vercel/blob": "^2.8.2",
    "next": "16.4.6",
    "openai": "5.23.2",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.7.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
